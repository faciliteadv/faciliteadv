generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- WORKSPACE CORE (NEW) ---

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     WorkspaceMember[]
  roles       Role[]
  
  // Domain Entities
  pipelines   KanbanPipeline[]
  clients     Client[]
  processes   Process[]
  cards       TaskCard[]
  tags        Tag[]
  
  @@index([slug])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  roleId      String
  joinedAt    DateTime @default(now())
  invitedBy   String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  isSystem    Boolean  @default(false)
  permissions Json     // ["kanban:read", "kanban:write", etc]

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  members     WorkspaceMember[]

  @@unique([workspaceId, name])
}

// --- DOMAIN ENTITIES ---

model Plan {
  id            String         @id @default(uuid())
  name          String
  maxClients    Int?
  maxProcesses  Int?
  maxStorageMB  Int?
  price         Decimal
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  planId    String
  status    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plan      Plan      @relation(fields: [planId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  name                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  // Relations
  workspaces           WorkspaceMember[]
  actionTypes          ActionType[]
  appointments         Appointment[]
  auditLogs            AuditLog[]
  clients              Client[]
  courts               Court[]
  districts            District[]
  // Orphans removed
  kanbanColumns        KanbanColumn[]
  
  responsibleProcesses Process[]      @relation("ResponsibleLawyer")
  processes            Process[]
  
  subscription         Subscription?
  
  assignedTasks        TaskCard[]     @relation("TaskAssignedBy")
  completedTasks       TaskCard[]     @relation("TaskCompletedBy")
  responsibleTasks     TaskCard[]     @relation("TaskResponsibleLawyer")
  taskCards            TaskCard[]     @relation("TaskCreator")
  
  points               UserPoints[]
}

// --- KANBAN SYSTEM (NEW & UPDATED) ---

model KanbanPipeline {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  position    Int      @default(0)
  isDefault   Boolean  @default(false)
  
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  columns     KanbanColumn[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model KanbanColumn {
  id         String   @id @default(uuid())
  name       String
  color      String   @default("#6366f1")
  position   Int      @default(0)
  
  // Relations
  pipelineId String
  pipeline   KanbanPipeline @relation(fields: [pipelineId], references: [id])

  userId     String   // Creator (kept for FK integrity)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  tasks      TaskCard[]

  @@unique([pipelineId, name])
  @@index([pipelineId, position])
}

model TaskCard {
  id                  String          @id @default(uuid())
  title               String
  description         String?
  type                TaskType        @default(INTERNAL)
  
  // Dates
  startDate           DateTime?
  endDate             DateTime?
  fatalDate           DateTime?
  publicationDate     DateTime?
  protocolDate        DateTime?
  completedAt         DateTime?
  
  // Status & Metadata
  isArchived          Boolean         @default(false)
  phase               String          @default("A Fazer")
  columnId            String
  position            Int             @default(0)
  
  protocoled          Boolean         @default(false)
  points              Int?
  
  // Enums
  daysCount           Int?
  daysType            DaysType?
  practiceArea        PracticeArea?

  // Relations
  workspaceId         String?
  workspace           Workspace?      @relation(fields: [workspaceId], references: [id])
  
  userId              String
  user                User            @relation("TaskCreator", fields: [userId], references: [id])
  
  clientId            String?
  client              Client?         @relation(fields: [clientId], references: [id])
  
  processId           String?
  process             Process?        @relation(fields: [processId], references: [id])
  
  responsibleLawyerId String?
  responsibleLawyer   User?           @relation("TaskResponsibleLawyer", fields: [responsibleLawyerId], references: [id])
  
  assignedById        String?
  assignedBy          User?           @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  
  completedById       String?
  completedBy         User?           @relation("TaskCompletedBy", fields: [completedById], references: [id])
  
  column              KanbanColumn    @relation(fields: [columnId], references: [id])
  
  checklist           ChecklistItem[]
  tags                Tag[]           @relation("TagToTaskCard")
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([fatalDate])
  @@index([phase])
  @@index([responsibleLawyerId])
  @@index([columnId, position])
  @@index([workspaceId, columnId])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        TaskCard @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
}

model Tag {
  id         String     @id @default(uuid())
  name       String
  color      String
  userId     String
  
  // Workspace Migration
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  
  tasks      TaskCard[] @relation("TagToTaskCard")
  
  @@index([workspaceId])
}

// --- OTHER DOMAIN ENTITIES (With Workspace Hooks) ---

model Client {
  id                     String            @id @default(uuid())
  type                   ClientType        @default(PF)
  name                   String
  cpfCnpj                String?
  rg                     String?
  ctps                   String?
  pis                    String?
  govAccessPassword      String?
  email                  String?
  whatsapp               String?
  address                Json?
  contacts               Json?
  acquisitionChannel     String?
  status                 ClientStatus      @default(NEW_LEAD)
  notes                  String?
  
  userId                 String
  user                   User              @relation(fields: [userId], references: [id])
  
  // Workspace Migration
  workspaceId            String?
  workspace              Workspace?        @relation(fields: [workspaceId], references: [id])

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  
  // PF Specifics
  fatherName             String?
  messageContactName     String?
  messageContactRelation String?
  motherName             String?
  civilStatus            String?
  profession             String?
  bankDetails            Json?
  
  // Relations
  appointments           Appointment[]
  financial              FinancialRecord[]
  processes              Process[]         @relation("ClientProcesses")
  processAuthors         ProcessAuthor[]
  processOpponents       ProcessOpponent[]
  tasks                  TaskCard[]

  @@index([userId])
  @@index([workspaceId])
  @@index([cpfCnpj])
}

model Process {
  id                  String            @id @default(uuid())
  folderName          String?
  number              String
  area                String
  courtLink           String?
  status              ProcessStatus     @default(ACTIVE)
  distributionDate    DateTime?
  
  clientId            String
  client              Client            @relation("ClientProcesses", fields: [clientId], references: [id])
  
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  
  // Workspace Migration
  workspaceId         String?
  workspace           Workspace?        @relation(fields: [workspaceId], references: [id])

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  
  // Details
  court               String?
  district            String?
  link                String?
  opponent            String?
  position            String?
  responsibleLawyerId String?
  responsibleLawyer   User?             @relation("ResponsibleLawyer", fields: [responsibleLawyerId], references: [id])
  
  actionType          String?
  claimValue          Decimal?
  
  appointments        Appointment[]
  financial           FinancialRecord[]
  authors             ProcessAuthor[]
  opponents           ProcessOpponent[]
  tasks               TaskCard[]

  @@index([userId])
  @@index([workspaceId])
  @@index([clientId])
}

// ... Rest of the models unchanged or minimally adapted ...

// DEPRECATED ORPHAN MODELS REMOVED
// CaseCard, INSSCase, CaseChecklistItem, INSSChecklistItem migrated to TaskCard

model FinancialRecord {
  id            String        @id @default(uuid())
  type          FinancialType
  amount        Decimal
  dueDate       DateTime
  paidAt        DateTime?
  description   String?
  clientId      String
  processId     String?
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  installment   String?
  paymentMethod String?
  
  client        Client        @relation(fields: [clientId], references: [id])
  process       Process?      @relation(fields: [processId], references: [id])

  @@index([clientId])
  @@index([userId])
}

model Appointment {
  id          String          @id @default(uuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  type        AppointmentType @default(MEETING)
  location    String?
  clientId    String?
  processId   String?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  client      Client?         @relation(fields: [clientId], references: [id])
  process     Process?        @relation(fields: [processId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startAt])
  @@index([clientId])
}

model ProcessAuthor {
  id        String   @id @default(uuid())
  processId String
  clientId  String
  position  String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  @@index([processId])
}

model ProcessOpponent {
  id        String   @id @default(uuid())
  processId String
  name      String
  cpfCnpj   String?
  position  String
  createdAt DateTime @default(now())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  @@index([processId])
  @@index([clientId])
}

model ActionType {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@unique([name, userId])
  @@index([userId])
}

model Court {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@unique([name, userId])
  @@index([userId])
}

model District {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@unique([name, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityId   String
  entityType String
  action     String
  oldData    Json?
  newData    Json?
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  @@index([entityId])
  @@index([userId])
}

model UserPoints {
  id        String   @id @default(uuid())
  userId    String
  month     Int
  year      Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, month, year])
  @@index([userId, year, month])
}

// Enums (Unchanged)
enum ClientType {
  PF
  PJ
}

enum ClientStatus {
  NEW_LEAD
  NEGOTIATING
  CONVERTED
  ACTIVE
  INACTIVE
}

enum ProcessStatus {
  CONSTRUCTION
  ACTIVE
  APPEAL
  SETTLEMENT
  ARCHIVED
  EXTINCT
  EXTINCT_WITH_JUDGMENT
  SUSPENDED
  SENTENCED
  EXECUTION
  EXTINCT_WITH_MERIT
  EXTINCT_WITHOUT_MERIT
  WITHDRAWAL
}

enum TaskType {
  DEADLINE
  INTERNAL
}

enum AppointmentType {
  MEETING
  HEARING
  DEADLINE
}

enum DaysType {
  BUSINESS
  CALENDAR
}


enum FinancialType {
  INCOME
  EXPENSE
}

enum PracticeArea {
  LABOR
  CIVIL
  FAMILY
  CRIMINAL
  HEALTH
  CONSUMER
  TAX
  SOCIAL_SECURITY
  OTHER
}
