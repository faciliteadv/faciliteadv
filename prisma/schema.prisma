generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  maxClients    Int?
  maxProcesses  Int?
  maxStorageMB  Int?
  price         Decimal
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  planId    String
  status    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plan      Plan      @relation(fields: [planId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  name                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  actionTypes          ActionType[]
  appointments         Appointment[]
  caseCards            CaseCard[]
  clients              Client[]
  inssCases            INSSCase[]
  kanbanColumns        KanbanColumn[]
  responsibleProcesses Process[]      @relation("ResponsibleLawyer")
  processes            Process[]
  subscription         Subscription?
  taskCards            TaskCard[]
  auditLogs            AuditLog[]
}

model KanbanColumn {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  boardType String   @default("tasks")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, boardType])
}

model Client {
  id                     String            @id @default(uuid())
  type                   ClientType        @default(PF)
  name                   String
  cpfCnpj                String?
  rg                     String?
  ctps                   String?
  pis                    String?
  govAccessPassword      String?
  email                  String?
  whatsapp               String?
  address                Json?
  contacts               Json?
  bankDetails            Json?
  acquisitionChannel     String?
  status                 ClientStatus      @default(NEW_LEAD)
  notes                  String?
  userId                 String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  fatherName             String?
  messageContactName     String?
  messageContactRelation String?
  motherName             String?
  civilStatus            String?
  profession             String?
  appointments           Appointment[]
  user                   User              @relation(fields: [userId], references: [id])
  financial              FinancialRecord[]
  processes              Process[]         @relation("ClientProcesses")
  processAuthors         ProcessAuthor[]
  tasks                  TaskCard[]

  @@index([userId])
  @@index([cpfCnpj])
}

model Process {
  id                  String            @id @default(uuid())
  folderName          String?
  number              String
  area                String
  courtLink           String?
  status              ProcessStatus     @default(ACTIVE)
  distributionDate    DateTime?
  clientId            String
  userId              String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  court               String?
  district            String?
  link                String?
  opponent            String?
  position            String?
  responsibleLawyerId String?
  actionType          String?
  claimValue          Decimal?
  appointments        Appointment[]
  financial           FinancialRecord[]
  client              Client            @relation("ClientProcesses", fields: [clientId], references: [id])
  responsibleLawyer   User?             @relation("ResponsibleLawyer", fields: [responsibleLawyerId], references: [id])
  user                User              @relation(fields: [userId], references: [id])
  authors             ProcessAuthor[]
  opponents           ProcessOpponent[]
  tasks               TaskCard[]

  @@index([userId])
  @@index([clientId])
}

model TaskCard {
  id          String          @id @default(uuid())
  title       String
  description String?
  type        TaskType        @default(INTERNAL)
  startDate   DateTime?
  endDate     DateTime?
  fatalDate   DateTime?
  isArchived  Boolean         @default(false)
  clientId    String?
  processId   String?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  phase       String          @default("TODO")
  checklist   ChecklistItem[]
  client      Client?         @relation(fields: [clientId], references: [id])
  process     Process?        @relation(fields: [processId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  tags        Tag[]           @relation("TagToTaskCard")

  @@index([userId])
  @@index([fatalDate])
  @@index([phase])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        TaskCard @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Tag {
  id     String     @id @default(uuid())
  name   String
  color  String
  userId String
  tasks  TaskCard[] @relation("TagToTaskCard")
}

model CaseCard {
  id            String              @id @default(uuid())
  clientName    String
  defendantName String?
  deadline      DateTime?
  description   String?
  isArchived    Boolean             @default(false)
  userId        String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  practiceArea  String              @default("OTHER")
  phase         String              @default("NEW_LEAD")
  user          User                @relation(fields: [userId], references: [id])
  checklist     CaseChecklistItem[]

  @@index([userId])
  @@index([phase])
  @@index([deadline])
}

model CaseChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  caseId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        CaseCard @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model INSSCase {
  id          String              @id @default(uuid())
  clientName  String
  clientCpf   String?
  govPassword String?
  deadline    DateTime?
  description String?
  isArchived  Boolean             @default(false)
  userId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  actionType  String              @default("OTHER")
  phase       String              @default("NEW_CASE")
  user        User                @relation(fields: [userId], references: [id])
  checklist   INSSChecklistItem[]

  @@index([userId])
  @@index([phase])
  @@index([deadline])
}

model INSSChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  inssId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inssCase    INSSCase @relation(fields: [inssId], references: [id], onDelete: Cascade)

  @@index([inssId])
}

model FinancialRecord {
  id          String    @id @default(uuid())
  type        String
  amount      Decimal
  dueDate     DateTime
  paidAt      DateTime?
  description String?
  clientId    String
  processId   String?
  userId      String
  createdAt   DateTime  @default(now())
  client      Client    @relation(fields: [clientId], references: [id])
  process     Process?  @relation(fields: [processId], references: [id])
}

model Appointment {
  id          String          @id @default(uuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  type        AppointmentType @default(MEETING)
  location    String?
  clientId    String?
  processId   String?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  client      Client?         @relation(fields: [clientId], references: [id])
  process     Process?        @relation(fields: [processId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startAt])
}

model ProcessAuthor {
  id        String   @id @default(uuid())
  processId String
  clientId  String
  position  String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model ProcessOpponent {
  id        String   @id @default(uuid())
  processId String
  name      String
  cpfCnpj   String?
  position  String
  createdAt DateTime @default(now())
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model ActionType {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([name, userId])
  @@index([userId])
}

enum ClientType {
  PF
  PJ
}

enum ClientStatus {
  NEW_LEAD
  NEGOTIATING
  CONVERTED
  ACTIVE
  INACTIVE
}

enum ProcessStatus {
  CONSTRUCTION
  ACTIVE
  APPEAL
  SETTLEMENT
  ARCHIVED
  EXTINCT
  EXTINCT_WITH_JUDGMENT
  SUSPENDED
  SENTENCED
  EXECUTION
  EXTINCT_WITH_MERIT
  EXTINCT_WITHOUT_MERIT
  WITHDRAWAL
}

enum TaskType {
  DEADLINE
  INTERNAL
}

enum AppointmentType {
  MEETING
  HEARING
  DEADLINE
}

model AuditLog {
  id         String   @id @default(uuid())
  entityId   String
  entityType String
  action     String
  oldData    Json?
  newData    Json?
  userId     String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([entityId])
  @@index([userId])
}
